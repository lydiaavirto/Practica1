#include <Arduino.h>

const int pinADC = A0;

void setup() {
  Serial.begin(9600);
}

void loop() {
  // 1. Lectura del valor del ADC (0 a 1023 por defecto - 10 bits - pero se puede cambiar)
  int valorADC = analogRead(pinADC);

  // 2. Cálculo de la tensión en Milivoltios (0 a 3300 mV)
  // 3300 son 1023, x son valorADC --> 
  long tension_mV = ((long)valorADC * 3300) / 1023;

  // 3. Formateo de la cadena de texto con sprintf()
  char buffer[64];
  sprintf(buffer, "ADC A0: %4d | Tension aproximada: %ld mV", valorADC, tension_mV);

  // 4. Muestra el resultado por el puerto serie
  Serial.println(buffer);

  // 5. Pausa de 1 segundo antes de la siguiente lectura
  delay(1000); 
}